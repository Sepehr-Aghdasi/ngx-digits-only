{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm",
        "analytics": "fe6a2d22-5935-4e1e-8378-5299052e3a9c"
    },
    "newProjectRoot": "projects",
    "projects": {
        "digits-only": {
            "projectType": "library",
            "root": "projects/digits-only",
            "sourceRoot": "projects/digits-only/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/digits-only/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/digits-only/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/digits-only/tsconfig.spec.json"
                    }
                }
            }
        }
    }
}
